DATABASE_URL="postgresql://user:password@localhost:5432/studywithai?schema=public&sslmode=require"
AUTH_SECRET="your-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# For Vercel deployment:
# - Set DATABASE_URL to your PostgreSQL database URL with ?sslmode=require
# - Set NEXTAUTH_URL to your production Vercel URL (e.g., https://your-app.vercel.app)
# - Set NEXTAUTH_SECRET to a secure random string
# - Ensure your database allows connections from Vercel's IP range or use a serverless-friendly provider like Supabase, Neon, or PlanetScale
